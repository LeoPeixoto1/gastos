{
  "name": "Gastos",
  "short_name": "Gastos",
  "description": "Controle de gastos do casal com IA",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1419",
  "theme_color": "#1f3b57",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Lançar gasto", "url": "./?tela=lancar" },
    { "name": "Painel", "url": "./?tela=painel" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "arquivo", "accept": ["application/pdf", "image/*", "text/csv", ".csv", ".ofx"] }]
    }
  }
}
